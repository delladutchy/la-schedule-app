# ---------------------------------------------------------------------------
# REQUIRED — Google OAuth (produced by `npm run google:auth`)
# ---------------------------------------------------------------------------

# OAuth 2.0 Client ID from Google Cloud Console (Desktop app type).
GOOGLE_CLIENT_ID=

# OAuth 2.0 Client secret from the same client.
GOOGLE_CLIENT_SECRET=

# Long-lived refresh token produced by the one-time auth flow.
# Treat this like a password — it gives read-only access to your calendar.
GOOGLE_REFRESH_TOKEN=

# ---------------------------------------------------------------------------
# REQUIRED — which calendars count as "blockers"
# ---------------------------------------------------------------------------
# Comma-separated list of Google Calendar IDs. ONLY these calendars are
# used to compute busy time. Everything else (birthdays, personal, tasks) is
# ignored. Use "primary" for your main calendar, or the full id shown in
# Google Calendar → Settings → [calendar] → "Integrate calendar" → Calendar ID.
#
# Example:
#   BLOCKER_CALENDAR_IDS=primary,abcd1234@group.calendar.google.com
BLOCKER_CALENDAR_IDS=

# Optional per-calendar display mode overrides:
# - details: show job/event details (default)
# - private: show only "Unavailable" (hide event titles)
#
# Format:
#   CALENDAR_DISPLAY_MODES=primary:details,abcd1234@group.calendar.google.com:private
# You can also use "=" as separator per entry:
#   CALENDAR_DISPLAY_MODES=primary=details,abcd1234@group.calendar.google.com=private
# CALENDAR_DISPLAY_MODES=

# ---------------------------------------------------------------------------
# REQUIRED — admin access token
# ---------------------------------------------------------------------------
# Used to gate /admin and POST /api/sync. Must be >= 16 chars.
# Generate with: `openssl rand -hex 32`
ADMIN_TOKEN=

# Preferred named editor tokens for LA Schedule editor mode.
# JSON object mapping editor id -> token, for example:
# EDITOR_TOKENS_JSON={"jeff":"...","dave":"...","milos":"..."}
# Tokens must be >= 16 chars.
EDITOR_TOKENS_JSON=

# Legacy single editor token fallback (optional; maps to editor id "legacy").
# Keep separate from ADMIN_TOKEN for least privilege.
# EDITOR_TOKEN=

# Google Calendar ID that editor writes should target.
# Example: primary
# Example: abcd1234@group.calendar.google.com
GOOGLE_CALENDAR_ID=

# ---------------------------------------------------------------------------
# OPTIONAL
# ---------------------------------------------------------------------------

# Netlify Blobs store name. Default is fine unless you want multiple sites
# sharing a single Netlify account without key collisions.
# BLOBS_STORE_NAME=availability-snapshots

# Optional Supabase snapshot-cache rollout flags.
# Defaults are false to preserve Netlify Blobs as primary behavior.
# SUPABASE_READS_ENABLED=false
# SUPABASE_WRITES_ENABLED=false

# Optional board payload cache flag.
# Default false keeps /api/board/window behavior on current uncached path.
# BOARD_CACHE_ENABLED=false

# Optional Google Places API key for Job Location autocomplete suggestions.
# Enables production-grade venue/address search via Google Places API (New).
# If absent, the autocomplete dropdown is silently disabled; manual typing
# and Apple Maps links continue to work normally.
# Key must be restricted to "Places API (New)" in Google Cloud Console.
# Server-side only — never exposed to the browser.
# GOOGLE_PLACES_API_KEY=

# Optional Supabase snapshot-cache connection (server-only).
# Required only when either SUPABASE_READS_ENABLED or SUPABASE_WRITES_ENABLED is true.
# Keep SUPABASE_SERVICE_ROLE_KEY secret and never expose it to clients.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Optional create-notification email settings (Resend).
# If all 3 are set, successful create operations send Jeff an email notice.
# If any are missing, email notifications are skipped.
# RESEND_API_KEY=
# NOTIFY_EMAIL_TO=
# NOTIFY_EMAIL_FROM=

# Optional Google Calendar webhook shared secret (Phase 1 receiver).
# Used by POST /api/google/calendar/webhook via:
# - query param: ?token=...
# - or header: x-goog-channel-token
# Keep this separate from ADMIN_TOKEN and editor tokens.
# GOOGLE_WEBHOOK_TOKEN=

# Optional canonical public site URL used for watch registration.
# When set, watch registration always targets:
#   ${PUBLIC_SITE_URL}/api/google/calendar/webhook
# trailing slash is normalized automatically.
# PUBLIC_SITE_URL=https://la-schedule-app.netlify.app

# Optional: server-side first-run bootstrap.
# Default: true
# When enabled, if the homepage detects "no usable snapshot", it will attempt
# one server-side sync (with backoff on failure) so a brand-new deploy can
# self-initialize without a manual curl.
# AUTO_BOOTSTRAP_ON_UNAVAILABLE=true

# ---------------------------------------------------------------------------
# OPTIONAL — automatic bank transaction ingestion through Plaid
# ---------------------------------------------------------------------------
# Plaid Link/OAuth handles bank authorization. Wells Fargo credentials are
# never requested or stored by this app. Keep all values below server-only.
# PLAID_ENV=sandbox
# PLAID_CLIENT_ID=
# PLAID_SECRET=
# PLAID_WEBHOOK_URL=https://la-schedule-app.netlify.app/api/plaid/webhook
# PLAID_REDIRECT_URI=https://la-schedule-app.netlify.app/admin/bank
# Generate once with: openssl rand -base64 32
# BANK_TOKEN_ENCRYPTION_KEY=
# Display-only billing context. The optional cost is entered by the operator.
# PLAID_PLAN_NAME=Trial
# PLAID_EXPECTED_MONTHLY_COST=
